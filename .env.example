# Copy to .env.local and fill in real values. Never commit .env.local.

# Gemini — used by /api/chat to generate answers — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the chat model
# GEMINI_MODEL=

# Pinecone — index with integrated embedding on the `chunk_text` field.
# Used by both ingestion (writes) and /api/chat (search).
PINECONE_API_KEY=
PINECONE_INDEX=

# Supabase — service role key is server-only; never expose it to the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
