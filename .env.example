# Copy to .env.local and fill in real values. Never commit .env.local.

# Gemini — used by /api/chat to generate answers — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the chat model
# GEMINI_MODEL=

# Pinecone — index with integrated embedding on the `chunk_text` field.
# Used by both ingestion (writes) and /api/chat (search).
PINECONE_API_KEY=
PINECONE_INDEX=

# Supabase — the URL may be named SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL.
# The service role (secret) key is server-only; never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/ingest/* (sent as "Authorization: Bearer <key>").
# Generate one with: openssl rand -hex 32. Ingestion is disabled while this is empty.
INGEST_API_KEY=
