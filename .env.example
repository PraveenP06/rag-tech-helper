# Copy to .env.local and fill in real values. Never commit .env.local.

# Gemini (embeddings) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Pinecone — index must be dense, dimension 768, metric cosine
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=default

# Supabase — service role key is server-only; never expose it to the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
